{
	// Cloudflare Worker configuration for the Consequence Visualizer
	"name": "cf-ai-consequence-engine",
	"main": "src/index.js",
	"compatibility_date": "2024-11-01",
	"compatibility_flags": [
		"nodejs_compat"
	],
	// Workers AI binding — provides access to Llama 3.3 and other models
	"ai": {
		"binding": "AI"
	},
	// KV Namespace binding — stores decisions, diary entries, and outcomes
	"kv_namespaces": [
		{
			"binding": "DECISIONS_KV",
			"id": "971451a5bc6c4c81a3eaa5fd413bc58e"
		}
	],
	// Cloudflare Workflows — durable multi-step execution for scheduled check-ins
	"workflows": [
		{
			"name": "checkin-workflow",
			"binding": "CHECKIN_WORKFLOW",
			"class_name": "CheckinWorkflow",
			"script_name": "cf-ai-consequence-engine"
		}
	],
	// Serve the public/ folder as static assets via Cloudflare Pages-style routing
	"assets": {
		"directory": "./public",
		"html_handling": "none",
		"binding": "ASSETS"
	}
}